# Database configuration
DATABASE_URL="file:./dev.db"

# Server configuration
PORT=3000
NODE_ENV=development

# Session & CSRF Secrets
SESSION_SECRET="change-this-to-a-secure-random-secret-at-least-32-chars"
CSRF_SECRET="change-this-to-a-secure-csrf-secret"
COOKIE_SECURE=false

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Optional OpenID Connect (OIDC) Stub
# If OIDC_ISSUER is set, the OIDC module/endpoints are enabled
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
